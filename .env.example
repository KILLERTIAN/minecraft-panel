# ---- Panel auth ----
ADMIN_PASSWORD=change_me_to_something_strong
JWT_SECRET=run__openssl_rand_hex_32__and_paste_here

# ---- Minecraft / RCON ----
RCON_PASSWORD=change_me_rcon_password
MC_MEMORY=3G
WORLD_NAME=world

# Address friends connect to in Minecraft.
# Local:  localhost:26666
# VPS:    minecraft.garcade.in:26666   (after SRV record) or play.garcade.in:26666
SERVER_ADDRESS=localhost:26666

# ---- Google Drive backups (optional; leave blank to keep backups local) ----
# Paste the FULL service-account JSON on one line.
GDRIVE_SERVICE_ACCOUNT_KEY=
GDRIVE_FOLDER_ID=

# ---- Scheduled backups (optional cron, e.g. "0 */6 * * *"; blank = off) ----
BACKUP_SCHEDULE=
